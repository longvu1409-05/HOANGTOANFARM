# ============================================================================
# CẤU HÌNH KẾT NỐI SUPABASE CHO HOÀNG TOÀN FARM
# Hướng dẫn:
# 1. Tạo 1 file mới tên là ".env" ngay cùng cấp với file ".env.example" này
# 2. Copy nội dung bên dưới sang file ".env" và điền giá trị từ Supabase của bạn
# ============================================================================

# Lấy trong Supabase Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Lấy trong Supabase Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# (Hoặc tab Legacy API Keys -> service_role secret)
# LƯU Ý: Khóa Secret chỉ đặt ở Backend (.env và Vercel), KHÔNG đặt tiền tố VITE_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx
